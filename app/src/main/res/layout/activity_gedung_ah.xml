<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tv_debug_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛠 Mode Developer"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#B71C1C"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gedung AH Lantai 1"
        android:textSize="13sp"
        android:textColor="#757575"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_calibration"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Kalibrasi RP"
        android:backgroundTint="#1565C0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_positioning"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Positioning (Debug)"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_analysis"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Analisis Parameter"
        android:backgroundTint="#E65100"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_zenodo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Zenodo Dataset"
        android:backgroundTint="#4A148C"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 — Q-WKNN Indoor Positioning"
        android:textSize="11sp"
        android:textColor="#BDBDBD"/>

</LinearLayout>