<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A237E"
    android:padding="40dp">

    <!-- Logo — tap 7x untuk masuk debug -->
    <ImageView
        android:id="@+id/img_logo_splash"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/logo_poltek"
        android:layout_marginBottom="32dp"
        android:contentDescription="Logo Politeknik Negeri Malang"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Q-WKNN Indoor Positioning"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gedung AH Lantai 1"
        android:textSize="14sp"
        android:textColor="#90CAF9"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Politeknik Negeri Malang"
        android:textSize="13sp"
        android:textColor="#90CAF9"
        android:gravity="center"
        android:layout_marginBottom="60dp"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Versi app di pojok bawah -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"
        android:textSize="11sp"
        android:textColor="#5C6BC0"
        android:layout_marginTop="40dp"/>

</LinearLayout>