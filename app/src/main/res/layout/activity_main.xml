<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Status bar posisi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1A237E"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Q-WKNN Indoor Positioning"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tekan Locate Me"
            android:textColor="#90CAF9"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Denah gedung — mengisi ruang tersisa -->
    <com.implementasi.myqwknn.ui.FloorMapView
        android:id="@+id/floor_map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"/>

    <!-- Panel bawah: navigasi + locate me -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="12dp">

        <!-- Keterangan navigasi -->
        <TextView
            android:id="@+id/tv_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#37474F"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <!-- Input tujuan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <AutoCompleteTextView
                android:id="@+id/et_tujuan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Cari ruangan tujuan..."
                android:textSize="14sp"
                android:padding="10dp"
                android:background="@android:drawable/edit_text"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:completionThreshold="1"/>

            <Button
                android:id="@+id/btn_clear_tujuan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="✕"
                android:textSize="16sp"
                android:padding="0dp"
                android:backgroundTint="#EEEEEE"
                android:textColor="#757575"
                android:visibility="gone"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <!-- Tombol Locate Me -->
        <Button
            android:id="@+id/btn_locate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📡  Locate Me"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>